################################################################################
# .htaccess – raiz do subdomínio dev.leiticia.com.br (React SPA + PWA)
################################################################################

# Requisitos: mod_rewrite, mod_headers, mod_expires, mod_deflate habilitados

# ------------------------------------------------------------------------------
# 1) REWRITE / SPA FALLBACK
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1.1) (opcional) força HTTPS no subdomínio de dev
  # Descomente quando o certificado do subdomínio estiver ok.
  #RewriteCond %{HTTPS} !=on
  #RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1.2) Bypass para arquivos estáticos do build do Vite/React
  RewriteRule ^(manifest\.json|service-worker\.js|offline\.html|robots\.txt)$ - [L]
  RewriteRule ^(assets|css|js|fonts|images|img|media|icons)/ - [L]

  # 1.3) SPA fallback: tudo que não for arquivo/pasta real cai no index.html
  #      Também marcamos uma variável de ambiente (IS_SPA) para ajustar cache.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L,QSA,E=IS_SPA:1]
</IfModule>

# ------------------------------------------------------------------------------
# 2) ÍNDICE / LISTAGEM
# ------------------------------------------------------------------------------
DirectoryIndex index.html
Options -Indexes

# ------------------------------------------------------------------------------
# 3) CACHE
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Estáticos (7 dias)
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType image/jpeg               "access plus 7 days"
  ExpiresByType image/png                "access plus 7 days"
  ExpiresByType image/gif                "access plus 7 days"
  ExpiresByType image/svg+xml            "access plus 7 days"
  ExpiresByType font/woff                "access plus 7 days"
  ExpiresByType font/woff2               "access plus 7 days"
</IfModule>

# Para HTML (index.html e rotas SPA), desabilitar cache agressivo:
<IfModule mod_headers.c>
  # Sem cache para respostas que passaram pelo fallback (IS_SPA=1)
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=IS_SPA
  # E também para o arquivo index.html acessado diretamente
  <FilesMatch "^(?i:index\.html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 4) SEO (dev): não indexar
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# ------------------------------------------------------------------------------
# 5) Segurança básica
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=()"
  # HSTS (ative só quando HTTPS estiver forçado de forma estável)
  #Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ------------------------------------------------------------------------------
# 6) GZIP / Brotli
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml
  AddOutputFilterByType DEFLATE text/css application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

################################################################################
# FIM
################################################################################
